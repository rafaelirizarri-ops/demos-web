# The Cloudflare Worker (wrangler.jsonc) reads this file from the root of its assets folder (sitios/); it is not served.
# Syntax: https://developers.cloudflare.com/workers/static-assets/headers/
# One splat (*) per rule; :name matches a single path segment.

# Fonts, scripts, images and video under each site's assets/ folder.
# Files there are not fingerprinted: give a changed file a new name so returning visitors get it.
/:site/assets/*
  Cache-Control: public, max-age=31536000, immutable

# conpav: client site in progress, kept out of search engines until it moves to its own domain.
/conpav/*
  X-Robots-Tag: noindex
